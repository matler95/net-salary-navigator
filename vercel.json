{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/api/stooq/(.*)",
      "destination": "/api/stooq/$1"
    },
    {
      "source": "/api/yahoo/(.*)",
      "destination": "/api/yahoo/$1"
    },
    {
      "source": "/((?!assets/|api/|favicon.ico).*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/server/**"
    }
  }
}
